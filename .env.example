# pdfCraft API Environment Configuration
# Copy this file to .env and configure for your environment

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server port (required by most cloud platforms)
PORT=8080

# Host binding (use 0.0.0.0 for cloud deployment)
HOST=0.0.0.0

# Environment mode (development, staging, production)
GO_ENV=production

# ===========================================
# FILE HANDLING CONFIGURATION
# ===========================================

# Maximum file size for uploads (e.g., 50MB, 100MB)
MAX_FILE_SIZE=50MB

# Upload directory (must be writable)
UPLOAD_DIR=/app/uploads

# Cache directory (must be writable)
CACHE_DIR=/app/cache

# Temporary files directory (must be writable)
TEMP_DIR=/app/temp

# Cache TTL in seconds (3600 = 1 hour)
CACHE_TTL=3600

# Maximum cache size (e.g., 1GB, 500MB)
MAX_CACHE_SIZE=1GB

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Enable CORS for web requests
ENABLE_CORS=true

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Enable HTTPS redirect
FORCE_HTTPS=true

# API key for protected endpoints (optional)
# API_KEY=your-secret-api-key

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================

# Rate limit: requests per hour per IP
RATE_LIMIT_REQUESTS=100

# Rate limit: time window in seconds
RATE_LIMIT_WINDOW=3600

# Rate limit: burst requests allowed
RATE_LIMIT_BURST=10

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (text, json)
LOG_FORMAT=json

# Log output (stdout, file)
LOG_OUTPUT=stdout

# Log file path (if LOG_OUTPUT=file)
LOG_FILE=/app/logs/pdfcraft.log

# ===========================================
# MONITORING CONFIGURATION
# ===========================================

# Enable metrics collection
ENABLE_METRICS=true

# Metrics port (for Prometheus scraping)
METRICS_PORT=9090

# Health check timeout in seconds
HEALTH_CHECK_TIMEOUT=10

# ===========================================
# REDIS CONFIGURATION (Optional)
# ===========================================

# Redis URL for distributed caching
# REDIS_URL=redis://localhost:6379

# Redis password (if required)
# REDIS_PASSWORD=your-redis-password

# Redis database number
# REDIS_DB=0

# ===========================================
# DATABASE CONFIGURATION (Optional)
# ===========================================

# Database URL (if using database for metadata)
# DATABASE_URL=postgresql://user:password@localhost:5432/pdfcraft

# ===========================================
# CLOUD STORAGE CONFIGURATION (Optional)
# ===========================================

# AWS S3 configuration
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Google Cloud Storage configuration
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCS_BUCKET=your-bucket-name

# ===========================================
# EXTERNAL SERVICES CONFIGURATION
# ===========================================

# Webhook URL for notifications (optional)
# WEBHOOK_URL=https://your-webhook-endpoint.com

# Email service configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=50

# Request timeout in seconds
REQUEST_TIMEOUT=300

# Worker pool size for PDF processing
WORKER_POOL_SIZE=10

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# Enable debug mode
DEBUG=false

# Enable request logging
LOG_REQUESTS=true

# Enable profiling endpoints
ENABLE_PROFILING=false

# ===========================================
# EXAMPLE PLATFORM-SPECIFIC CONFIGURATIONS
# ===========================================

# Heroku example:
# PORT=8080 (automatically set by Heroku)
# GO_ENV=production
# MAX_FILE_SIZE=50MB
# CACHE_TTL=3600

# Railway example:
# PORT=8080 (automatically set by Railway)
# GO_ENV=production
# ENABLE_CORS=true

# Google Cloud Run example:
# PORT=8080 (automatically set by Cloud Run)
# GO_ENV=production
# MAX_FILE_SIZE=32MB (Cloud Run limit)

# AWS ECS example:
# PORT=8080
# GO_ENV=production
# AWS_REGION=us-east-1
# ENABLE_METRICS=true